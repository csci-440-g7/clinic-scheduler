@page "/Error"
@using System.Diagnostics
@using MudBlazor

<PageTitle>Error</PageTitle>

<div style="display:flex; flex-direction:column; align-items:center; justify-content:center; height:60vh; gap:16px;">
    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Style="font-size:5rem;" />
    <MudText Typo="Typo.h4">An Error Occurred</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary">An error occurred while processing your request.</MudText>

    @if (ShowRequestId)
    {
        <MudAlert Severity="Severity.Error" Dense="true">
            <strong>Request ID:</strong> <code>@RequestId</code>
        </MudAlert>
    }

    <MudAlert Severity="Severity.Warning" Dense="true" Style="max-width:520px;">
        For more detail, set <strong>ASPNETCORE_ENVIRONMENT</strong> to <strong>Development</strong> and restart the app.
        Do not enable Development mode in deployed applications.
    </MudAlert>

    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Dashboard">
        Back to Dashboard
    </MudButton>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
