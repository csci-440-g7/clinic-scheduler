@page "/dashboard/patient"
@inject NavigationManager Nav
@inject IDbContextFactory<ClinicDbContext> DbFactory
@inject IRepository<Therapist> TherapistRepo
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar

@attribute [Authorize(Roles = "Patient")]

<div class="role-shell">
    <div class="role-header">
        <h2>@PatientDashboardTitle</h2>
        <div class="role-actions">
            <span class="role-badge">Role: Patient</span>
        </div>
    </div>

    @if (_patientNotFound)
    {
        <p>Patient record not found.</p>
    }
    else if (_patient is not null)
    {
        <div class="role-tabs">
            <button class="@GetTabClass("calendar")" @onclick="@(() => SetTab("calendar"))">Calendar</button>
            <button class="@GetTabClass("profile")" @onclick="@(() => SetTab("profile"))">Profile</button>
            <button class="@GetTabClass("notes")" @onclick="@(() => SetTab("notes"))">Notes</button>
        </div>

        <div class="role-body">
            @if (activeTab == "calendar")
            {
                <CalendarView ViewerRole="patient" PatientId="@_patient.Id" />
            }
            else if (activeTab == "profile")
            {
                <div class="panel">
                    <h3>Personal Info</h3>

                    <label class="field-label">Name</label>
                    <input class="field-input" value="@_patient.FullName" disabled />

                    <label class="field-label">Phone</label>
                    <input class="field-input" @bind="_editPhone" />

                    <label class="field-label">Email</label>
                    <input class="field-input" @bind="_editEmail" />

                    <label class="field-label">Date of Birth</label>
                    <input class="field-input" value="@_patient.DateOfBirth.ToString("yyyy-MM-dd")" disabled />

                    <div style="margin-top: 12px;">
                        <button class="primary" @onclick="SaveProfileAsync">Save</button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_profileSavedMessage))
                    {
                        <p class="success">@_profileSavedMessage</p>
                    }
                </div>
            }
            else if (activeTab == "notes")
            {
                <div class="panel">
                    <h3>Doctor Notes</h3>
                    <p class="muted">Notes from your appointments.</p>

                    @if (_appointmentNotes.Count == 0)
                    {
                        <p>No notes found.</p>
                    }
                    else
                    {
                        <div class="notes-toolbar">
                            <label class="notes-filter-label" for="notes-doctor-filter">Show notes from</label>
                            <select id="notes-doctor-filter" class="notes-filter-select" @bind="_notesDoctorFilter">
                                <option value="">All doctors</option>
                                @foreach (var author in _distinctAuthors)
                                {
                                    <option value="@author">@author</option>
                                }
                            </select>
                        </div>

                        @if (!FilteredAppointmentNotes.Any())
                        {
                            <p class="muted">No notes for this selection.</p>
                        }
                        else
                        {
                            @foreach (var group in NotesGroupedByDoctor)
                            {
                                <h4 class="note-group-heading">@group.Key</h4>
                                <ul class="note-list">
                                    @foreach (var a in group.OrderByDescending(x => x.StartTime))
                                    {
                                        <li class="note-item">
                                            <div class="note-meta">
                                                <span>@a.StartTime.ToLocalTime().ToString("MMM d, yyyy")</span>
                                                <span class="dot">•</span>
                                                <span>Author: @a.Therapist.FullName</span>
                                            </div>
                                            <div class="note-text">@a.Notes</div>
                                        </li>
                                    }
                                </ul>
                            }
                        }
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private string activeTab = "calendar";

    private Patient? _patient;
    private bool _patientNotFound;
    private List<Appointment> _appointmentNotes = new();
    private string _notesDoctorFilter = "";

    private string _editPhone = "";
    private string _editEmail = "";
    private string? _profileSavedMessage;

    protected override async Task OnInitializedAsync()
    {
        var authStateResult = await AuthState.GetAuthenticationStateAsync();
        var user = authStateResult.User;
        var email = user.Identity?.Name;

        if (string.IsNullOrEmpty(email))
        {
            _patientNotFound = true;
            return;
        }

        await using var DbContext = await DbFactory.CreateDbContextAsync();
        _patient = await DbContext.Patients.FirstOrDefaultAsync(p => p.Email == email);

        if (_patient is null)
        {
            _patientNotFound = true;
            return;
        }

        _editPhone = _patient.Phone ?? "";
        _editEmail = _patient.Email;

        _appointmentNotes = await DbContext.Appointments
            .Include(a => a.Therapist)
            .Where(a => a.PatientId == _patient.Id && a.Notes != null)
            .OrderByDescending(a => a.StartTime)
            .ToListAsync();
    }

    private IEnumerable<string> _distinctAuthors =>
        _appointmentNotes.Select(a => a.Therapist.FullName).Distinct().OrderBy(a => a, StringComparer.OrdinalIgnoreCase);

    private IEnumerable<Appointment> FilteredAppointmentNotes =>
        string.IsNullOrEmpty(_notesDoctorFilter)
            ? _appointmentNotes
            : _appointmentNotes.Where(a => a.Therapist.FullName == _notesDoctorFilter);

    private IEnumerable<IGrouping<string, Appointment>> NotesGroupedByDoctor =>
        FilteredAppointmentNotes
            .GroupBy(a => a.Therapist.FullName)
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        var tab = GetTabFromQuery();
        if (tab is not null)
        {
            activeTab = tab;
        }
    }

    private async Task SaveProfileAsync()
    {
        if (_patient is null) return;

        _profileSavedMessage = null;

        try
        {
            await using var DbContext = await DbFactory.CreateDbContextAsync();
            var tracked = await DbContext.Patients.FindAsync(_patient.Id);
            if (tracked is null) return;
            tracked.UpdateContactInfo(_editEmail?.Trim() ?? "", _editPhone?.Trim());
            await DbContext.SaveChangesAsync();
            _patient = tracked;
            _profileSavedMessage = "Profile saved.";
            Snackbar.Add("Profile saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving profile: {ex.Message}", Severity.Error);
        }
    }

    private void SetTab(string tab)
    {
        if (activeTab == tab)
        {
            return;
        }

        activeTab = tab;
        Nav.NavigateTo($"/dashboard/patient?tab={Uri.EscapeDataString(tab)}", false, true);
    }

    private string? GetTabFromQuery()
    {
        try
        {
            var uri = new Uri(Nav.Uri);
            var query = uri.Query.TrimStart('?');
            if (string.IsNullOrWhiteSpace(query))
            {
                return null;
            }

            foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var kv = part.Split('=', 2);
                if (kv.Length == 2 && kv[0] == "tab")
                {
                    var tab = Uri.UnescapeDataString(kv[1]);
                    return tab is "calendar" or "profile" or "notes" ? tab : null;
                }
            }

            return null;
        }
        catch
        {
            return null;
        }
    }

    private string GetTabClass(string tab) => tab == activeTab ? "tab active" : "tab";

    private string PatientDashboardTitle => _patient is not null
        ? $"{_patient.FullName}'s Dashboard"
        : "Patient Dashboard";
}

<style>
    .role-shell { max-width: 1100px; margin: 0 auto; }
    .role-header { display:flex; align-items:center; justify-content:space-between; margin-bottom: 12px; }
    .role-actions { display:flex; align-items:center; gap: 12px; }
    .role-badge { color:#555; font-size: 14px; }
    .role-tabs { display:flex; flex-wrap: wrap; gap: 10px; margin: 8px 0 14px 0; }
    .tab { padding: 8px 14px; border: 1px solid #ddd; background: #fff; cursor:pointer; border-radius: 6px; }
    .tab.active { border-color: #3b82f6; background: #eff6ff; }
    .role-body { }
    .panel { border:1px solid #e5e7eb; border-radius: 10px; padding: 14px; background: #fff; }
    .field-label { display:block; margin-top: 10px; color:#555; font-weight: 600; }
    .field-input { width: 100%; padding: 8px 10px; border:1px solid #ddd; border-radius: 8px; }
    .field-textarea { width: 100%; padding: 8px 10px; border:1px solid #ddd; border-radius: 8px; font: inherit; resize: vertical; min-height: 52px; box-sizing: border-box; }
    .link-button { background: transparent; border: none; cursor:pointer; color:#2563eb; text-decoration: underline; }
    .primary { background:#2563eb; color:#fff; border:none; padding: 10px 14px; border-radius: 8px; cursor:pointer; }
    .success { color:#16a34a; margin-top: 10px; }
    .muted { color:#6b7280; }
    .note-list { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap: 10px; }
    .note-item { border:1px solid #e5e7eb; border-radius: 10px; padding: 12px; background: #fafafa; }
    .note-meta { display:flex; gap: 8px; align-items:center; color:#6b7280; font-size: 13px; }
    .dot { font-size: 18px; line-height: 0; }
    .note-text { margin-top: 6px; white-space: pre-wrap; }
    .notes-toolbar { margin-bottom: 14px; display:flex; flex-wrap:wrap; align-items:center; gap: 10px; }
    .notes-filter-label { font-size: 13px; font-weight: 600; color:#374151; }
    .notes-filter-select { padding: 8px 10px; border:1px solid #d1d5db; border-radius: 8px; font: inherit; min-width: 200px; background:#fff; }
    .note-group-heading { margin: 16px 0 8px; font-size: 14px; font-weight: 800; color:#111827; }
    .note-group-heading:first-of-type { margin-top: 0; }
</style>
