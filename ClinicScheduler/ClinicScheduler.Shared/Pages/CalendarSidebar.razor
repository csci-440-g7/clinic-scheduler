@inject ClinicDbContext DbContext
@inject AppointmentSchedulingService SchedulingService
@inject IRepository<Room> RoomRepo
@inject IRepository<Therapist> TherapistRepo
@inject ISnackbar Snackbar

<div class="calendar-sidebar">
    <div class="mini-month">
        <div class="month-nav">
            <button class="nav-btn" title="Previous month" @onclick="PrevMonth">‹</button>
            <div class="month-title">@_currentMonth.ToString("MMMM yyyy")</div>
            <button class="nav-btn" title="Next month" @onclick="NextMonth">›</button>
        </div>

        <div class="dow-row">
            @foreach (var d in _dayLabels)
            {
                <div class="dow">@d</div>
            }
        </div>

        <div class="mini-grid">
            @for (int i = 0; i < 42; i++)
            {
                var cellDate = _miniGridStart.AddDays(i);
                var outside = cellDate.Month != _currentMonth.Month;
                var inWeek = cellDate.Date >= WeekStart.Date && cellDate.Date < WeekStart.Date.AddDays(7);
                var selected = cellDate.Date == FocusedDate.Date;

                <button class="mini-day @(outside ? "outside" : "") @(inWeek ? "in-week" : "") @(selected ? "selected" : "")"
                        type="button"
                        @onclick="() => OnDayClicked(cellDate)">
                    @cellDate.Day
                </button>
            }
        </div>
    </div>

    <div class="sidebar-lists">
        @if (ViewerRole == "staff")
        {
            <section class="sidebar-section">
                <h4 class="sidebar-heading sidebar-heading-requests">
                    Pending Requests
                    @if (_pendingRequests.Count > 0)
                    {
                        <span class="sidebar-pending-badge">@_pendingRequests.Count</span>
                    }
                </h4>
                @if (_pendingRequests.Count == 0)
                {
                    <p class="sidebar-empty">No pending requests.</p>
                }
                else
                {
                    <ul class="sidebar-ul">
                        @foreach (var r in _pendingRequests)
                        {
                            <li>
                                <div class="sidebar-req-card">
                                    <div class="sidebar-req-meta">
                                        <span class="sidebar-req-patient">@(r.Patient?.FullName ?? "Unknown patient")</span>
                                        <span class="sidebar-req-detail">@r.PreferredDateTime.ToString("MMM d") · @r.PreferredDateTime.ToString("h:mm tt")</span>
                                        <span class="sidebar-req-detail">@(r.PreferredTherapist?.FullName ?? "No preference")</span>
                                        @if (!string.IsNullOrWhiteSpace(r.Notes))
                                        {
                                            <span class="sidebar-req-reason">@r.Notes</span>
                                        }
                                    </div>
                                    <div class="sidebar-req-actions">
                                        <button type="button" class="sidebar-req-confirm" @onclick="() => ConfirmRequest(r)">Confirm</button>
                                        <button type="button" class="sidebar-req-decline" @onclick="() => DeclineRequest(r)">Decline</button>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>
        }

        <section class="sidebar-section">
            <h4 class="sidebar-heading">Recent</h4>
            @if (_recentAppointments.Count == 0)
            {
                <p class="sidebar-empty">No past appointments.</p>
            }
            else
            {
                <ul class="sidebar-ul">
                    @foreach (var a in _recentAppointments)
                    {
                        <li>
                            <button type="button" class="sidebar-appt @(SelectedId == a.Id ? "active" : "")"
                                    @onclick="() => OnAppointmentSelected.InvokeAsync(a)">
                                <span class="sidebar-appt-title">@(a.TherapyType?.Name ?? a.Status.ToString())</span>
                                <span class="sidebar-appt-when">@a.StartTime.ToString("MMM d") · @FormatRange(a)</span>
                                <span class="sidebar-appt-sub">@Subtitle(a)</span>
                            </button>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="sidebar-section">
            <h4 class="sidebar-heading">Upcoming</h4>
            @if (_upcomingAppointments.Count == 0)
            {
                <p class="sidebar-empty">Nothing scheduled ahead.</p>
            }
            else
            {
                <ul class="sidebar-ul">
                    @foreach (var a in _upcomingAppointments)
                    {
                        <li>
                            <button type="button" class="sidebar-appt @(SelectedId == a.Id ? "active" : "")"
                                    @onclick="() => OnAppointmentSelected.InvokeAsync(a)">
                                <span class="sidebar-appt-title">@(a.TherapyType?.Name ?? a.Status.ToString())</span>
                                <span class="sidebar-appt-when">@a.StartTime.ToString("MMM d") · @FormatRange(a)</span>
                                <span class="sidebar-appt-sub">@Subtitle(a)</span>
                            </button>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="sidebar-section">
            <h4 class="sidebar-heading">Follow-ups</h4>
            @if (_followUpAppointments.Count == 0)
            {
                <p class="sidebar-empty">No follow-up visits on file.</p>
            }
            else
            {
                <ul class="sidebar-ul">
                    @foreach (var a in _followUpAppointments)
                    {
                        <li>
                            <button type="button" class="sidebar-appt @(SelectedId == a.Id ? "active" : "")"
                                    @onclick="() => OnAppointmentSelected.InvokeAsync(a)">
                                <span class="sidebar-appt-title">@(a.TherapyType?.Name ?? a.Status.ToString())</span>
                                <span class="sidebar-appt-when">@a.StartTime.ToString("MMM d") · @FormatRange(a)</span>
                                <span class="sidebar-appt-sub">@Subtitle(a)</span>
                            </button>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</div>

@code {
    [Parameter] public string ViewerRole { get; set; } = "staff";
    [Parameter] public int? PatientId { get; set; }
    [Parameter] public int? TherapistId { get; set; }
    [Parameter] public DateTime WeekStart { get; set; }
    [Parameter] public DateTime FocusedDate { get; set; }
    [Parameter] public int? SelectedId { get; set; }
    [Parameter] public EventCallback<DateTime> OnDateSelected { get; set; }
    [Parameter] public EventCallback<Appointment> OnAppointmentSelected { get; set; }
    [Parameter] public EventCallback OnAppointmentStatusChanged { get; set; }

    private DateTime _currentMonth;
    private List<Appointment> _recentAppointments = new();
    private List<Appointment> _upcomingAppointments = new();
    private List<Appointment> _followUpAppointments = new();
    private List<AppointmentRequest> _pendingRequests = new();

    private readonly string[] _dayLabels = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private DateTime _miniGridStart => MiniGridStart(_currentMonth);

    protected override async Task OnInitializedAsync()
    {
        _currentMonth = new DateTime(WeekStart.Year, WeekStart.Month, 1);
        await LoadSidebarDataAsync();
    }

    protected override void OnParametersSet()
    {
        // Sync mini-calendar when week navigation crosses a month boundary.
        var weekMonth = new DateTime(WeekStart.Year, WeekStart.Month, 1);
        if (weekMonth != _currentMonth && FocusedDate.Month == WeekStart.Month)
            _currentMonth = weekMonth;
    }

    private void PrevMonth() => _currentMonth = _currentMonth.AddMonths(-1);
    private void NextMonth() => _currentMonth = _currentMonth.AddMonths(1);

    private void OnDayClicked(DateTime date)
    {
        _currentMonth = new DateTime(date.Year, date.Month, 1);
        OnDateSelected.InvokeAsync(date);
    }

    private async Task LoadSidebarDataAsync()
    {
        await LoadSidebarAppointmentsAsync();

        if (ViewerRole == "staff")
        {
            _pendingRequests = await DbContext.AppointmentRequests
                .Include(r => r.Patient)
                .Include(r => r.PreferredTherapist)
                .Where(r => r.Status == AppointmentRequestStatus.Pending)
                .OrderBy(r => r.PreferredDateTime)
                .ToListAsync();
        }
    }

    private async Task LoadSidebarAppointmentsAsync()
    {
        var now = DateTime.UtcNow;
        var baseQuery = BuildViewerQuery();

        _recentAppointments = await baseQuery
            .Where(a => a.EndTime < now)
            .OrderByDescending(a => a.StartTime)
            .Take(5)
            .ToListAsync();

        _upcomingAppointments = await BuildViewerQuery()
            .Where(a => a.StartTime > now)
            .OrderBy(a => a.StartTime)
            .Take(5)
            .ToListAsync();

        _followUpAppointments = await BuildViewerQuery()
            .Where(a => a.TherapyType != null
                && a.TherapyType.Name.Contains("follow")
                && a.StartTime > now)
            .OrderBy(a => a.StartTime)
            .Take(5)
            .ToListAsync();
    }

    private IQueryable<Appointment> BuildViewerQuery()
    {
        var query = DbContext.Appointments
            .Include(a => a.Patient)
            .Include(a => a.Therapist)
            .Include(a => a.Room)
            .Include(a => a.TherapyType)
            .AsQueryable();

        if (ViewerRole == "patient" && PatientId.HasValue)
            query = query.Where(a => a.PatientId == PatientId.Value);
        else if (ViewerRole == "doctor" && TherapistId.HasValue)
            query = query.Where(a => a.TherapistId == TherapistId.Value);

        return query;
    }

    private async Task ConfirmRequest(AppointmentRequest request)
    {
        try
        {
            // Use the preferred therapist, or fall back to the first available therapist
            var therapistId = request.PreferredTherapistId
                ?? (await TherapistRepo.GetAllAsync()).FirstOrDefault()?.Id
                ?? 0;

            // Use the first available room
            var roomId = (await RoomRepo.GetAllAsync()).FirstOrDefault()?.Id ?? 0;

            var appt = await SchedulingService.CreateAppointmentAsync(
                request.PatientId,
                therapistId,
                roomId,
                request.PreferredDateTime,
                TimeSpan.FromMinutes(30));

            var tracked = await DbContext.AppointmentRequests.FindAsync(request.Id);
            tracked!.Approve(appt);
            await DbContext.SaveChangesAsync();

            _pendingRequests.Remove(request);
            Snackbar.Add("Request approved and appointment booked.", Severity.Success);
            await OnAppointmentStatusChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not approve request: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeclineRequest(AppointmentRequest request)
    {
        var tracked = await DbContext.AppointmentRequests.FindAsync(request.Id);
        if (tracked is null) return;
        tracked.Deny();
        await DbContext.SaveChangesAsync();

        _pendingRequests.Remove(request);
        Snackbar.Add("Request declined.", Severity.Info);
        await OnAppointmentStatusChanged.InvokeAsync();
    }

    private string Subtitle(Appointment a) => ViewerRole switch
    {
        "patient" => a.Therapist?.FullName ?? "Unknown",
        "doctor" => a.Patient?.FullName ?? "Unknown",
        "staff" => $"{a.Patient?.FullName ?? "Unknown"} · {a.Therapist?.FullName ?? "Unknown"}",
        _ => ""
    };

    private static string FormatRange(Appointment a) =>
        $"{a.StartTime:h:mm tt} – {a.EndTime:h:mm tt}";

    private static DateTime MiniGridStart(DateTime month)
    {
        var first = new DateTime(month.Year, month.Month, 1);
        var offset = ((int)first.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return first.AddDays(-offset);
    }
}
