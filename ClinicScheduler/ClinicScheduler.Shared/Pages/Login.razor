@page "/login"
@attribute [AllowAnonymous]
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Class="pa-8" Elevation="4">
        <MudText Typo="Typo.h5" Class="mb-6">Sign In</MudText>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        <form method="post" action="/account/login">
            <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "/")" />

            <MudTextField @bind-Value="_email" Label="Email" Variant="Variant.Outlined"
                          InputType="InputType.Email" Class="mb-4"
                          name="email" />
            <MudTextField @bind-Value="_password" Label="Password" Variant="Variant.Outlined"
                          InputType="InputType.Password" Class="mb-6"
                          name="password" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                       Color="Color.Primary" FullWidth="true">
                Sign In
            </MudButton>
        </form>
    </MudPaper>
</MudContainer>

@code {
    private string _email = "";
    private string _password = "";
    private string? _errorMessage;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    protected override void OnInitialized()
    {
        _errorMessage = Error switch
        {
            "1" => "Invalid email or password.",
            "2" => "Account is locked. Try again later.",
            _ => null
        };
    }
}
