@page "/dashboard/doctor"
@inject NavigationManager Nav
@inject ClinicDbContext DbContext
@inject IRepository<Patient> PatientRepo
@inject IRepository<Therapist> TherapistRepo
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar

@attribute [Authorize(Roles = "Therapist")]

<div class="role-shell">
    <div class="role-header">
        <h2>@DoctorDashboardTitle</h2>
        <div class="role-actions">
            <span class="role-badge">Role: Therapist</span>
        </div>
    </div>

    @if (_therapistNotFound)
    {
        <p>Therapist record not found.</p>
    }
    else if (_therapist is not null)
    {
        <div class="role-tabs">
            <button class="@GetTabClass("calendar")" @onclick="@(() => SetTab("calendar"))">Calendar</button>
            <button class="@GetTabClass("patients")" @onclick="@(() => SetTab("patients"))">Patient Search</button>
            <button class="@GetTabClass("notes")" @onclick="@(() => SetTab("notes"))">Notes</button>
        </div>

        <div class="role-body">
            @if (activeTab == "calendar")
            {
                <CalendarView ViewerRole="doctor" TherapistId="@_therapist.Id" />
            }
            else if (activeTab == "patients")
            {
                <div class="panel">
                    <h3>Search Patients</h3>
                    <input class="field-input"
                           placeholder="Search patient name"
                           value="@patientSearchTerm"
                           @oninput="(e) => OnPatientSearchChanged(e.Value?.ToString())" />
                    <div style="margin-top: 12px;">
                        @if (_filteredPatients.Count == 0)
                        {
                            <p class="muted">No matches.</p>
                        }
                        else
                        {
                            <ul class="list">
                                @foreach (var p in _filteredPatients)
                                {
                                    <li class="list-item">
                                        <button type="button" class="list-item-btn" @onclick="() => OpenPatientDetail(p)">
                                            <div class="list-main">
                                                <div class="list-title">@p.FullName</div>
                                                <div class="list-sub">@p.Phone</div>
                                                <div class="list-hint">View profile</div>
                                            </div>
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
            else if (activeTab == "notes")
            {
                <div class="panel">
                    <div class="panel-row">
                        <h3 style="margin:0;">Doctor Notes</h3>
                        <label class="toggle">
                            <input type="checkbox" @bind="doctorCanSeeNotes" />
                            <span>Show notes</span>
                        </label>
                    </div>

                    @if (!doctorCanSeeNotes)
                    {
                        <p class="muted">Notes are hidden in this view.</p>
                    }
                    else if (_appointmentNotes.Count == 0)
                    {
                        <p>No notes found.</p>
                    }
                    else
                    {
                        <div class="notes-toolbar">
                            <label class="notes-filter-label" for="notes-patient-filter">Show notes for</label>
                            <select id="notes-patient-filter" class="notes-filter-select" @bind="_notesPatientFilterId">
                                <option value="0">All patients</option>
                                @foreach (var p in _patientsWithNotes.OrderBy(x => x.FullName))
                                {
                                    <option value="@p.Id">@p.FullName</option>
                                }
                            </select>
                        </div>

                        @if (!FilteredAppointmentNotes.Any())
                        {
                            <p class="muted">No notes for this selection.</p>
                        }
                        else
                        {
                            @foreach (var group in NotesGroupedByPatient)
                            {
                                <h4 class="note-group-heading">@group.Key</h4>
                                <ul class="note-list">
                                    @foreach (var a in group.OrderByDescending(x => x.StartTime))
                                    {
                                        <li class="note-item">
                                            <div class="note-meta">
                                                <span>@a.StartTime.ToLocalTime().ToString("MMM d, yyyy")</span>
                                                <span class="dot">•</span>
                                                <span>Patient: @a.Patient.FullName</span>
                                            </div>
                                            <div class="note-text">@a.Notes</div>
                                        </li>
                                    }
                                </ul>
                            }
                        }
                    }
                </div>
            }
        </div>
    }
</div>

@if (_patientDetail is not null)
{
    <div class="modal-root" @onclick="ClosePatientDetail" role="dialog" aria-modal="true">
        <div class="modal-panel modal-panel-wide" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3 class="modal-title">Patient information</h3>
                <button type="button" class="modal-close" @onclick="ClosePatientDetail" title="Close">×</button>
            </div>
            <div class="modal-fields">
                <div class="modal-field">
                    <span class="modal-k">Name</span>
                    <span class="modal-v">@_patientDetail.FullName</span>
                </div>
                <div class="modal-field">
                    <span class="modal-k">Date of birth</span>
                    <span class="modal-v">@_patientDetail.DateOfBirth.ToString("MMM d, yyyy")</span>
                </div>
                <div class="modal-field">
                    <span class="modal-k">Phone</span>
                    <span class="modal-v">@(_patientDetail.Phone ?? "—")</span>
                </div>
                <div class="modal-field">
                    <span class="modal-k">Email</span>
                    <span class="modal-v">@_patientDetail.Email</span>
                </div>
                <div class="modal-field modal-field-block">
                    <span class="modal-k">Notes</span>
                    <span class="modal-v">@(string.IsNullOrWhiteSpace(_patientDetail.Notes) ? "—" : _patientDetail.Notes)</span>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "calendar";
    private bool doctorCanSeeNotes = true;

    private Therapist? _therapist;
    private bool _therapistNotFound;

    private List<Patient> _filteredPatients = new();
    private List<Appointment> _appointmentNotes = new();
    private int _notesPatientFilterId;
    private string patientSearchTerm = "";

    private Patient? _patientDetail;

    protected override async Task OnInitializedAsync()
    {
        var authStateResult = await AuthState.GetAuthenticationStateAsync();
        var user = authStateResult.User;
        var email = user.Identity?.Name;

        if (string.IsNullOrEmpty(email))
        {
            _therapistNotFound = true;
            return;
        }

        _therapist = await DbContext.Therapists.FirstOrDefaultAsync(t => t.Email == email);

        if (_therapist is null)
        {
            _therapistNotFound = true;
            return;
        }

        await LoadAppointmentNotesAsync();
        await ApplyPatientFilterAsync();
    }

    protected override void OnParametersSet()
    {
        var tab = GetTabFromQuery();
        if (tab is not null)
        {
            activeTab = tab;
        }
    }

    private async Task OnPatientSearchChanged(string? term)
    {
        patientSearchTerm = term ?? "";
        await ApplyPatientFilterAsync();
    }

    private async Task ApplyPatientFilterAsync()
    {
        var term = (patientSearchTerm ?? "").Trim();
        if (string.IsNullOrWhiteSpace(term))
        {
            _filteredPatients = await DbContext.Patients.ToListAsync();
        }
        else
        {
            _filteredPatients = await DbContext.Patients
                .Where(p => p.FirstName.Contains(term) || p.LastName.Contains(term))
                .ToListAsync();
        }
    }

    private async Task LoadAppointmentNotesAsync()
    {
        if (_therapist is null) return;

        _appointmentNotes = await DbContext.Appointments
            .Include(a => a.Patient)
            .Where(a => a.TherapistId == _therapist.Id && a.Notes != null)
            .OrderByDescending(a => a.StartTime)
            .ToListAsync();
    }

    private IEnumerable<Patient> _patientsWithNotes =>
        _appointmentNotes
            .Select(a => a.Patient)
            .DistinctBy(p => p.Id)
            .ToList();

    private IEnumerable<Appointment> FilteredAppointmentNotes =>
        _notesPatientFilterId == 0
            ? _appointmentNotes
            : _appointmentNotes.Where(a => a.PatientId == _notesPatientFilterId);

    private IEnumerable<IGrouping<string, Appointment>> NotesGroupedByPatient =>
        FilteredAppointmentNotes
            .GroupBy(a => a.Patient.FullName)
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase);

    private void OpenPatientDetail(Patient p)
    {
        _patientDetail = p;
    }

    private void ClosePatientDetail() => _patientDetail = null;

    private string DoctorDashboardTitle => _therapist is not null
        ? $"{_therapist.FullName}'s Dashboard"
        : "Therapist Dashboard";

    private void SetTab(string tab)
    {
        if (activeTab == tab)
        {
            return;
        }

        activeTab = tab;
        Nav.NavigateTo($"/dashboard/doctor?tab={Uri.EscapeDataString(tab)}", false, true);
    }

    private string? GetTabFromQuery()
    {
        try
        {
            var uri = new Uri(Nav.Uri);
            var query = uri.Query.TrimStart('?');
            if (string.IsNullOrWhiteSpace(query))
            {
                return null;
            }

            foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var kv = part.Split('=', 2);
                if (kv.Length == 2 && kv[0] == "tab")
                {
                    var tab = Uri.UnescapeDataString(kv[1]);
                    return tab is "calendar" or "patients" or "notes" ? tab : null;
                }
            }

            return null;
        }
        catch
        {
            return null;
        }
    }

    private string GetTabClass(string tab) => tab == activeTab ? "tab active" : "tab";
}

@* lightweight inline styles *@
<style>
    .role-shell { max-width: 1100px; margin: 0 auto; }
    .role-header { display:flex; align-items:center; justify-content:space-between; margin-bottom: 12px; }
    .role-actions { display:flex; align-items:center; gap: 12px; }
    .role-badge { color:#555; font-size: 14px; }
    .role-tabs { display:flex; flex-wrap: wrap; gap: 10px; margin: 8px 0 14px 0; }
    .tab { padding: 8px 14px; border: 1px solid #ddd; background: #fff; cursor:pointer; border-radius: 6px; }
    .tab.active { border-color: #3b82f6; background: #eff6ff; }
    .role-body { }
    .panel { border:1px solid #e5e7eb; border-radius: 10px; padding: 14px; background: #fff; }
    .field-input { width: 100%; padding: 8px 10px; border:1px solid #ddd; border-radius: 8px; }
    .muted { color:#6b7280; }
    .note-list { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap: 10px; }
    .note-item { border:1px solid #e5e7eb; border-radius: 10px; padding: 12px; background: #fafafa; }
    .note-meta { display:flex; gap: 8px; align-items:center; color:#6b7280; font-size: 13px; }
    .dot { font-size: 18px; line-height: 0; }
    .note-text { margin-top: 6px; white-space: pre-wrap; }
    .list { list-style:none; padding:0; margin: 0; display:flex; flex-direction:column; gap:10px; }
    .list-item { border:1px solid #e5e7eb; border-radius: 10px; padding: 0; background:#fafafa; overflow:hidden; }
    .list-item-btn { width:100%; text-align:left; border:none; background:transparent; cursor:pointer; font:inherit; padding: 12px; color:inherit; }
    .list-item-btn:hover { background:#eff6ff; }
    .list-title { font-weight: 700; }
    .list-sub { color:#6b7280; font-size: 13px; margin-top: 4px; }
    .list-hint { margin-top: 8px; font-size: 12px; font-weight: 600; color:#2563eb; }
    .modal-root { position:fixed; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center; padding:20px; box-sizing:border-box; background:rgba(15,23,42,0.45); backdrop-filter:blur(2px); }
    .modal-panel { width:100%; max-width:440px; max-height:90vh; overflow:auto; border-radius:14px; background:#fff; padding:16px 18px; box-shadow:0 25px 50px -12px rgba(0,0,0,0.25); }
    .modal-panel-wide { max-width:480px; }
    .modal-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:8px; }
    .modal-title { margin:0; font-size:16px; font-weight:800; color:#111827; }
    .modal-close { width:32px; height:32px; border-radius:8px; border:1px solid #e5e7eb; background:#fff; cursor:pointer; font-size:20px; line-height:1; color:#6b7280; }
    .modal-close:hover { background:#f3f4f6; color:#111827; }
    .modal-fields { display:flex; flex-direction:column; gap:12px; font-size:14px; }
    .modal-field { display:grid; grid-template-columns:120px 1fr; gap:10px; align-items:start; }
    .modal-field-block { grid-template-columns: 1fr; }
    .modal-k { color:#6b7280; font-weight:600; }
    .modal-v { color:#111827; word-break:break-word; white-space:pre-wrap; }
    .panel-row { display:flex; justify-content:space-between; align-items:center; gap: 12px; }
    .toggle { display:flex; gap: 8px; align-items:center; color:#374151; user-select:none; }
    .notes-toolbar { margin-bottom: 14px; display:flex; flex-wrap:wrap; align-items:center; gap: 10px; }
    .notes-filter-label { font-size: 13px; font-weight: 600; color:#374151; }
    .notes-filter-select { padding: 8px 10px; border:1px solid #d1d5db; border-radius: 8px; font: inherit; min-width: 200px; background:#fff; }
    .note-group-heading { margin: 16px 0 8px; font-size: 14px; font-weight: 800; color:#111827; }
    .note-group-heading:first-of-type { margin-top: 0; }
</style>
