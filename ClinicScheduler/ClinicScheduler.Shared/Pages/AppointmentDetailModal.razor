@inject IDbContextFactory<ClinicDbContext> DbFactory

<div class="appt-modal-root"
     @onclick="OnClose"
     role="dialog"
     aria-modal="true"
     aria-labelledby="appt-modal-title">
    <div class="appt-modal-panel" @onclick:stopPropagation="true">
        <div class="appt-detail">
            <div class="appt-detail-header">
                <h3 id="appt-modal-title" class="appt-detail-title">Appointment</h3>
                <button type="button" class="appt-detail-close" @onclick="OnClose" title="Close">×</button>
            </div>
            <div class="appt-detail-grid">
                <div class="appt-detail-row">
                    <span class="k">When</span>
                    <span class="v">@Appointment.StartTime.ToString("dddd, MMM d, yyyy") · @FormatRange()</span>
                </div>
                <div class="appt-detail-row">
                    <span class="k">Patient</span>
                    <span class="v">@(Appointment.Patient?.FullName ?? "Unknown")</span>
                </div>
                <div class="appt-detail-row">
                    <span class="k">Doctor</span>
                    <span class="v">@(Appointment.Therapist?.FullName ?? "Unknown")</span>
                </div>
                @if (ViewerRole is "patient" or "doctor")
                {
                    <div class="appt-detail-row">
                        <span class="k">Room</span>
                        <span class="v">@(Appointment.Room?.Name ?? "—")</span>
                    </div>
                    @if (ViewerRole == "doctor")
                    {
                        <div class="appt-detail-edit">
                            <label class="appt-detail-label" for="meeting-notes">Meeting notes</label>
                            <textarea id="meeting-notes"
                                      class="appt-detail-textarea"
                                      rows="4"
                                      @bind="_editNotes"
                                      @bind:event="oninput"></textarea>
                            <div class="appt-detail-actions">
                                <button type="button" class="appt-detail-save" @onclick="SaveNotesAsync">Save notes</button>
                                @if (!string.IsNullOrWhiteSpace(_savedMessage))
                                {
                                    <span class="appt-detail-saved">@_savedMessage</span>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="appt-detail-row appt-detail-notes">
                            <span class="k">Notes</span>
                            <span class="v">@(string.IsNullOrWhiteSpace(Appointment.Notes) ? "—" : Appointment.Notes)</span>
                        </div>
                    }
                }
                else
                {
                    <p class="appt-detail-staff-hint">Staff scheduling view: patient and doctor are shown. Location, room, and clinical notes are visible to patients and care providers only.</p>
                }

                @if (ViewerRole == "patient" && Appointment.Status is AppointmentStatus.Scheduled or AppointmentStatus.Rescheduled)
                {
                    <div class="appt-cancel-section">
                        @if (_hasPendingCancelRequest)
                        {
                            <span class="appt-cancel-pending">
                                <span class="appt-cancel-pending-icon">⏳</span>
                                Cancellation request pending
                            </span>
                        }
                        else
                        {
                            <button type="button" class="appt-cancel-btn" @onclick="() => _showCancelForm = true">
                                Request Cancellation
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (_showCancelForm)
{
    <CancelRequestModal Appointment="Appointment"
                        OnClose="() => _showCancelForm = false"
                        OnRequested="OnCancelRequestedAsync" />
}

@code {
    [Parameter, EditorRequired] public Appointment Appointment { get; set; } = default!;
    [Parameter] public string ViewerRole { get; set; } = "staff";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnStatusChanged { get; set; }

    private string _editNotes = "";
    private string? _savedMessage;
    private bool _showCancelForm;
    private bool _hasPendingCancelRequest;

    protected override async Task OnParametersSetAsync()
    {
        _editNotes = Appointment.Notes ?? "";
        _savedMessage = null;
        _showCancelForm = false;
        await CheckPendingCancelRequestAsync();
    }

    private async Task CheckPendingCancelRequestAsync()
    {
        await using var DbContext = await DbFactory.CreateDbContextAsync();
        _hasPendingCancelRequest = await DbContext.CancelAppointmentRequests
            .AnyAsync(r => r.AppointmentId == Appointment.Id && r.Status == AppointmentRequestStatus.Pending);
    }

    private async Task OnCancelRequestedAsync()
    {
        _showCancelForm = false;
        await CheckPendingCancelRequestAsync();
        await OnStatusChanged.InvokeAsync();
    }

    private async Task SaveNotesAsync()
    {
        if (ViewerRole != "doctor") return;
        await using var DbContext = await DbFactory.CreateDbContextAsync();
        var tracked = await DbContext.Appointments.FindAsync(Appointment.Id);
        if (tracked is not null)
        {
            tracked.Notes = string.IsNullOrWhiteSpace(_editNotes) ? null : _editNotes.Trim();
            await DbContext.SaveChangesAsync();
            Appointment.Notes = tracked.Notes;
        }
        _savedMessage = "Saved.";
        await OnStatusChanged.InvokeAsync();
    }

    private string FormatRange() => $"{Appointment.StartTime:h:mm tt} – {Appointment.EndTime:h:mm tt}";
}
