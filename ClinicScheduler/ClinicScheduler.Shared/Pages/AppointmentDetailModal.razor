@using ClinicScheduler.Shared.Services
@inject ClinicDataStore Data

<div class="appt-modal-root"
     @onclick="OnClose"
     role="dialog"
     aria-modal="true"
     aria-labelledby="appt-modal-title">
    <div class="appt-modal-panel" @onclick:stopPropagation="true">
        <div class="appt-detail">
            <div class="appt-detail-header">
                <h3 id="appt-modal-title" class="appt-detail-title">Appointment</h3>
                <button type="button" class="appt-detail-close" @onclick="OnClose" title="Close">×</button>
            </div>
            <div class="appt-detail-grid">
                @if (Appointment.Status == "pending")
                {
                    <div class="appt-detail-row">
                        <span class="k">Status</span>
                        <span class="v appt-status-pending">Pending confirmation</span>
                    </div>
                }
                <div class="appt-detail-row">
                    <span class="k">When</span>
                    <span class="v">@Appointment.Start.ToString("dddd, MMM d, yyyy") · @FormatRange()</span>
                </div>
                <div class="appt-detail-row">
                    <span class="k">Patient</span>
                    <span class="v">@(Data.GetPatient(Appointment.PatientId)?.Name ?? "Unknown")</span>
                </div>
                <div class="appt-detail-row">
                    <span class="k">Doctor</span>
                    <span class="v">@(MockClinicData.Doctors.FirstOrDefault(d => d.Id == Appointment.DoctorId)?.Name ?? "Unknown")</span>
                </div>
                @if (ViewerRole is "patient" or "doctor")
                {
                    <div class="appt-detail-row">
                        <span class="k">Location</span>
                        <span class="v">@Appointment.Location</span>
                    </div>
                    <div class="appt-detail-row">
                        <span class="k">Room</span>
                        <span class="v">@Appointment.RoomNumber</span>
                    </div>
                    @if (ViewerRole == "doctor")
                    {
                        <div class="appt-detail-edit">
                            <label class="appt-detail-label" for="meeting-notes">Meeting notes</label>
                            <textarea id="meeting-notes"
                                      class="appt-detail-textarea"
                                      rows="4"
                                      @bind="_editNotes"
                                      @bind:event="oninput"></textarea>
                            <div class="appt-detail-actions">
                                <button type="button" class="appt-detail-save" @onclick="SaveNotes">Save notes</button>
                                @if (!string.IsNullOrWhiteSpace(_savedMessage))
                                {
                                    <span class="appt-detail-saved">@_savedMessage</span>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="appt-detail-row appt-detail-notes">
                            <span class="k">Notes</span>
                            <span class="v">@(string.IsNullOrWhiteSpace(Appointment.MeetingNotes) ? "—" : Appointment.MeetingNotes)</span>
                        </div>
                    }
                }
                else
                {
                    <p class="appt-detail-staff-hint">Staff scheduling view: patient and doctor are shown. Location, room, and clinical notes are visible to patients and care providers only.</p>
                    @if (Appointment.Status == "pending")
                    {
                        <div class="appt-detail-actions">
                            <button type="button" class="appt-detail-approve" @onclick="Approve">Confirm</button>
                            <button type="button" class="appt-detail-decline" @onclick="Decline">Decline</button>
                            @if (!string.IsNullOrWhiteSpace(_statusMessage))
                            {
                                <span class="appt-detail-saved">@_statusMessage</span>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_statusMessage))
                    {
                        <span class="appt-detail-saved">@_statusMessage</span>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MockClinicData.Appointment Appointment { get; set; } = default!;
    [Parameter] public string ViewerRole { get; set; } = "staff";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnStatusChanged { get; set; }

    private string _editNotes = "";
    private string? _savedMessage;
    private string? _statusMessage;

    protected override void OnParametersSet()
    {
        _editNotes = Appointment.MeetingNotes ?? "";
        _savedMessage = null;
        _statusMessage = null;
    }

    private void SaveNotes()
    {
        if (ViewerRole != "doctor") return;
        Data.UpdateAppointmentMeetingNotes(
            Appointment.Id,
            string.IsNullOrWhiteSpace(_editNotes) ? null : _editNotes.Trim());
        _savedMessage = "Saved.";
    }

    private async Task Approve()
    {
        Data.UpdateAppointmentStatus(Appointment.Id, "confirmed");
        _statusMessage = "Confirmed.";
        await OnStatusChanged.InvokeAsync();
    }

    private async Task Decline()
    {
        Data.UpdateAppointmentStatus(Appointment.Id, "declined");
        _statusMessage = "Declined.";
        await OnStatusChanged.InvokeAsync();
    }

    private string FormatRange() => $"{Appointment.Start:h:mm tt} – {Appointment.End:h:mm tt}";
}
