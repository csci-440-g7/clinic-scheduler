@inject ClinicDbContext DbContext

<div class="calendar-shell">
    <CalendarSidebar ViewerRole="@ViewerRole"
                     PatientId="@PatientId"
                     TherapistId="@EffectiveTherapistId"
                     WeekStart="@_weekStart"
                     FocusedDate="@_focusedDate"
                     SelectedId="@_selected?.Id"
                     OnDateSelected="OnDateSelected"
                     OnAppointmentSelected="OnSidebarAppointmentSelected"
                     OnAppointmentStatusChanged="OnAppointmentStatusChanged" />

    <div class="week-panel">
        <div class="week-header">
            <button class="nav-btn" title="Previous week" @onclick="PrevWeek">‹</button>
            <div class="week-title">
                Week of @_weekStart.ToString("MMM d") – @_weekStart.AddDays(6).ToString("MMM d, yyyy")
            </div>
            <button class="nav-btn" title="Next week" @onclick="NextWeek">›</button>
            @if (ViewerRole is "staff" or "doctor")
            {
                <button type="button" class="btn-book" @onclick="OpenBookForm">+ Book Appointment</button>
            }
            else if (ViewerRole == "patient")
            {
                <button type="button" class="btn-book" @onclick="OpenRequestForm">+ Request Appointment</button>
            }
        </div>

        <div class="week-grid">
            <div class="time-col" style="height:@(DayBodyHeightPx + DayHeaderHeightPx)px;">
                <div class="time-header"></div>
                @for (int h = StartHour; h < EndHour; h++)
                {
                    <div class="time-label">@FormatHour(h)</div>
                }
            </div>

            @foreach (var day in _weekDays)
            {
                <div class="day-col">
                    <div class="day-header">
                        <div class="day-name">@day.ToString("ddd")</div>
                        <div class="day-date">@day.ToString("MMM d")</div>
                    </div>
                    <div class="day-body" style="height:@(DayBodyHeightPx)px;">
                        @foreach (var appt in AppointmentsForDay(day))
                        {
                            <button type="button"
                                    class="appt-card @ApptCss(appt) @(_selected?.Id == appt.Id ? "selected" : "")"
                                    style="@ApptStyle(day, appt)"
                                    @onclick="() => ToggleAppointment(appt)">
                                <div class="appt-title">@ApptTitle(appt)</div>
                                <div class="appt-time">@FormatRange(appt)</div>
                                <div class="appt-sub">@Subtitle(appt)</div>
                                <div class="appt-hint">@(_selected?.Id == appt.Id ? "Hide details" : "Details")</div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @if (_selected is not null)
    {
        <AppointmentDetailModal Appointment="@_selected"
                                ViewerRole="@ViewerRole"
                                OnClose="CloseDetail"
                                OnStatusChanged="RefreshSelected" />
    }
</div>

@if (_showBookForm)
{
    <BookAppointmentModal InitialDate="@_focusedDate"
                          OnClose="CloseBookForm"
                          OnBooked="CloseBookForm" />
}

@if (_showRequestForm)
{
    <RequestAppointmentModal InitialDate="@_focusedDate"
                             OnClose="CloseRequestForm"
                             OnRequested="CloseRequestForm" />
}

@code {
    [Parameter] public string ViewerRole { get; set; } = "staff";
    [Parameter] public int? PatientId { get; set; }
    [Parameter] public int? TherapistId { get; set; }

    private const int StartHour = 7;
    private const int EndHour = 19;
    private const int HourHeightPx = 40;
    private const int DayHeaderHeightPx = 54;
    private int DayBodyHeightPx => (EndHour - StartHour) * HourHeightPx;

    private DateTime _weekStart;
    private DateTime _focusedDate;
    private IEnumerable<DateTime> _weekDays => Enumerable.Range(0, 7).Select(i => _weekStart.AddDays(i));

    private Appointment? _selected;
    private List<Appointment> _weekAppointments = new();
    private bool _showBookForm;
    private bool _showRequestForm;

    protected override async Task OnInitializedAsync()
    {
        _focusedDate = DateTime.UtcNow.Date;
        _weekStart = WeekStartMonday(_focusedDate);
        await LoadWeekAppointmentsAsync();
    }

    private async Task PrevWeek()
    {
        _weekStart = _weekStart.AddDays(-7);
        _focusedDate = _weekStart;
        await LoadWeekAppointmentsAsync();
    }

    private async Task NextWeek()
    {
        _weekStart = _weekStart.AddDays(7);
        _focusedDate = _weekStart;
        await LoadWeekAppointmentsAsync();
    }

    private async Task OnDateSelected(DateTime date)
    {
        _focusedDate = date.Date;
        _weekStart = WeekStartMonday(_focusedDate);
        await LoadWeekAppointmentsAsync();
    }

    private void OnSidebarAppointmentSelected(Appointment appt) =>
        _selected = _weekAppointments.FirstOrDefault(a => a.Id == appt.Id) ?? appt;

    private void ToggleAppointment(Appointment appt)
    {
        if (_selected?.Id == appt.Id) { _selected = null; return; }
        _selected = appt;
    }

    private void CloseDetail() => _selected = null;

    private async Task RefreshSelected()
    {
        await LoadWeekAppointmentsAsync();
        if (_selected is not null)
            _selected = _weekAppointments.FirstOrDefault(a => a.Id == _selected.Id);
    }

    private async Task OnAppointmentStatusChanged()
    {
        await RefreshSelected();
        StateHasChanged();
    }

    private void OpenBookForm() => _showBookForm = true;
    private void CloseBookForm() => _showBookForm = false;
    private void OpenRequestForm() => _showRequestForm = true;
    private void CloseRequestForm() => _showRequestForm = false;

    private static DateTime WeekStartMonday(DateTime date)
    {
        var d = date.Date;
        return d.AddDays(-(((int)d.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7));
    }

    /// <summary>
    /// Resolve the effective therapist ID.
    /// </summary>
    private int? EffectiveTherapistId => TherapistId;

    private async Task LoadWeekAppointmentsAsync()
    {
        var weekEnd = _weekStart.AddDays(7);

        var query = DbContext.Appointments
            .Include(a => a.Patient)
            .Include(a => a.Therapist)
            .Include(a => a.Room)
            .Include(a => a.TherapyType)
            .Where(a => a.StartTime < weekEnd && a.EndTime > _weekStart);

        var effectiveTherapistId = EffectiveTherapistId;

        query = ViewerRole switch
        {
            "patient" when PatientId.HasValue => query.Where(a => a.PatientId == PatientId.Value),
            "doctor" when effectiveTherapistId.HasValue => query.Where(a => a.TherapistId == effectiveTherapistId.Value),
            "staff" => query,
            _ => query.Where(a => false) // no results for unknown viewer
        };

        _weekAppointments = await query.OrderBy(a => a.StartTime).ToListAsync();
    }

    private IEnumerable<Appointment> AppointmentsForDay(DateTime day) =>
        _weekAppointments.Where(a => a.StartTime.Date == day.Date).OrderBy(a => a.StartTime);

    private string Subtitle(Appointment a) => ViewerRole switch
    {
        "patient" => a.Therapist?.FullName ?? "Unknown",
        "doctor" => a.Patient?.FullName ?? "Unknown",
        "staff" => $"{a.Patient?.FullName ?? "Unknown"} · {a.Therapist?.FullName ?? "Unknown"}",
        _ => ""
    };

    private static string ApptTitle(Appointment a) =>
        a.TherapyType?.Name ?? a.Status.ToString();

    private static string ApptCss(Appointment a)
    {
        // Use TherapyType color code if available, otherwise fall back to status-based styling
        if (a.TherapyType is not null)
        {
            // Map known therapy type names to CSS classes for backward compatibility
            var name = a.TherapyType.Name.ToLowerInvariant();
            if (name.Contains("medical") || name.Contains("therapy")) return "appt-medical";
            if (name.Contains("lab")) return "appt-lab";
            if (name.Contains("intake") || name.Contains("assessment")) return "appt-intake";
            if (name.Contains("admin")) return "appt-admin";
        }

        // Fall back to status-based styling
        return a.Status switch
        {
            AppointmentStatus.Scheduled => "appt-medical",
            AppointmentStatus.Completed => "appt-lab",
            AppointmentStatus.Canceled => "appt-admin",
            AppointmentStatus.Missed => "appt-intake",
            AppointmentStatus.Rescheduled => "appt-default",
            _ => "appt-default"
        };
    }

    private static string FormatHour(int h) => DateTime.Today.AddHours(h).ToString("h:mm tt");
    private static string FormatRange(Appointment a) => $"{a.StartTime:h:mm tt} – {a.EndTime:h:mm tt}";

    private string ApptStyle(DateTime day, Appointment a)
    {
        var startMin = (a.StartTime - day.Date).TotalMinutes;
        var endMin = (a.EndTime - day.Date).TotalMinutes;
        var visStart = Math.Max(startMin, StartHour * 60);
        var visEnd = Math.Min(endMin, EndHour * 60);
        var top = (visStart - StartHour * 60) / 60d * HourHeightPx;
        var height = Math.Max((visEnd - visStart) / 60d * HourHeightPx, 18);
        return $"top:{top:0}px; height:{height:0}px;";
    }
}
