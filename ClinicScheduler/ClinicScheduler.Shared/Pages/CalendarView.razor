@using ClinicScheduler.Shared.Services
@inject ClinicDataStore Data

<div class="calendar-shell">
    <CalendarSidebar ViewerRole="@ViewerRole"
                     PatientId="@PatientId"
                     DoctorId="@DoctorId"
                     WeekStart="@_weekStart"
                     FocusedDate="@_focusedDate"
                     SelectedId="@_selected?.Id"
                     OnDateSelected="OnDateSelected"
                     OnAppointmentSelected="OnSidebarAppointmentSelected"
                     OnAppointmentStatusChanged="OnAppointmentStatusChanged" />

    <div class="week-panel">
        <div class="week-header">
            <button class="nav-btn" title="Previous week" @onclick="PrevWeek">‹</button>
            <div class="week-title">
                Week of @_weekStart.ToString("MMM d") – @_weekStart.AddDays(6).ToString("MMM d, yyyy")
            </div>
            <button class="nav-btn" title="Next week" @onclick="NextWeek">›</button>
            @if (ViewerRole is "staff" or "doctor")
            {
                <button type="button" class="btn-book" @onclick="OpenBookForm">+ Book Appointment</button>
            }
            else if (ViewerRole == "patient")
            {
                <button type="button" class="btn-book" @onclick="OpenRequestForm">+ Request Appointment</button>
            }
        </div>

        <div class="week-grid">
            <div class="time-col" style="height:@(DayBodyHeightPx + DayHeaderHeightPx)px;">
                <div class="time-header"></div>
                @for (int h = StartHour; h < EndHour; h++)
                {
                    <div class="time-label">@FormatHour(h)</div>
                }
            </div>

            @foreach (var day in _weekDays)
            {
                <div class="day-col">
                    <div class="day-header">
                        <div class="day-name">@day.ToString("ddd")</div>
                        <div class="day-date">@day.ToString("MMM d")</div>
                    </div>
                    <div class="day-body" style="height:@(DayBodyHeightPx)px;">
                        @foreach (var appt in AppointmentsForDay(day))
                        {
                            <button type="button"
                                    class="appt-card @ApptCss(appt.Type) @(_selected?.Id == appt.Id ? "selected" : "") @(appt.Status == "pending" ? "appt-pending" : "")"
                                    style="@ApptStyle(day, appt)"
                                    @onclick="() => ToggleAppointment(appt)">
                                @if (appt.Status == "pending")
                                {
                                    <div class="appt-status-badge">Pending</div>
                                }
                                <div class="appt-title">@appt.Title</div>
                                <div class="appt-time">@FormatRange(appt)</div>
                                <div class="appt-sub">@Subtitle(appt)</div>
                                <div class="appt-hint">@(_selected?.Id == appt.Id ? "Hide details" : "Details")</div>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @if (_selected is not null)
    {
        <AppointmentDetailModal Appointment="@_selected"
                                ViewerRole="@ViewerRole"
                                OnClose="CloseDetail"
                                OnStatusChanged="RefreshSelected" />
    }
</div>

@if (_showBookForm)
{
    <BookAppointmentModal InitialDate="@_focusedDate"
                          OnClose="CloseBookForm"
                          OnBooked="CloseBookForm" />
}

@if (_showRequestForm)
{
    <RequestAppointmentModal PatientId="@(PatientId ?? "")"
                             InitialDate="@_focusedDate"
                             OnClose="CloseRequestForm"
                             OnRequested="CloseRequestForm" />
}

@code {
    [Parameter] public string ViewerRole { get; set; } = "staff";
    [Parameter] public string? PatientId { get; set; }
    [Parameter] public string? DoctorId { get; set; }

    private const int StartHour = 7;
    private const int EndHour = 19;
    private const int HourHeightPx = 40;
    private const int DayHeaderHeightPx = 54;
    private int DayBodyHeightPx => (EndHour - StartHour) * HourHeightPx;

    private DateTime _weekStart;
    private DateTime _focusedDate;
    private IEnumerable<DateTime> _weekDays => Enumerable.Range(0, 7).Select(i => _weekStart.AddDays(i));

    private MockClinicData.Appointment? _selected;
    private bool _showBookForm;
    private bool _showRequestForm;

    protected override void OnInitialized()
    {
        _focusedDate = DateTime.Today.Date;
        _weekStart = WeekStartMonday(_focusedDate);
    }

    private void PrevWeek() { _weekStart = _weekStart.AddDays(-7); _focusedDate = _weekStart; }
    private void NextWeek() { _weekStart = _weekStart.AddDays(7);  _focusedDate = _weekStart; }

    private void OnDateSelected(DateTime date)
    {
        _focusedDate = date.Date;
        _weekStart = WeekStartMonday(_focusedDate);
    }

    private void OnSidebarAppointmentSelected(MockClinicData.Appointment appt) =>
        _selected = Data.GetAppointment(appt.Id) ?? appt;

    private void ToggleAppointment(MockClinicData.Appointment appt)
    {
        if (_selected?.Id == appt.Id) { _selected = null; return; }
        _selected = Data.GetAppointment(appt.Id) ?? appt;
    }

    private void CloseDetail() => _selected = null;
    private void RefreshSelected()
    {
        if (_selected is not null)
            _selected = Data.GetAppointment(_selected.Id) ?? _selected;
    }

    private void OnAppointmentStatusChanged()
    {
        // Refresh selected appointment if it was the one actioned from the sidebar.
        RefreshSelected();
        StateHasChanged();
    }
    private void OpenBookForm() => _showBookForm = true;
    private void CloseBookForm() => _showBookForm = false;
    private void OpenRequestForm() => _showRequestForm = true;
    private void CloseRequestForm() => _showRequestForm = false;

    private static DateTime WeekStartMonday(DateTime date)
    {
        var d = date.Date;
        return d.AddDays(-(((int)d.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7));
    }

    private IEnumerable<MockClinicData.Appointment> ForViewer()
    {
        IEnumerable<MockClinicData.Appointment> q = Data.Appointments;
        return ViewerRole switch
        {
            "patient" when !string.IsNullOrWhiteSpace(PatientId) => q.Where(a => a.PatientId == PatientId),
            "doctor"  when !string.IsNullOrWhiteSpace(DoctorId)  => q.Where(a => a.DoctorId  == DoctorId),
            "staff"                                               => q,
            _                                                     => Enumerable.Empty<MockClinicData.Appointment>()
        };
    }

    private IEnumerable<MockClinicData.Appointment> AppointmentsForDay(DateTime day)
    {
        var weekEnd = _weekStart.AddDays(7);
        return ForViewer()
            .Where(a => a.Start < weekEnd && a.End > _weekStart && a.Start.Date == day.Date)
            .OrderBy(a => a.Start);
    }

    private string Subtitle(MockClinicData.Appointment a)
    {
        var patient = Data.GetPatient(a.PatientId) ?? new MockClinicData.Patient("?", "Unknown", DateTime.Today, "", "", "", "");
        var doctor  = MockClinicData.Doctors.FirstOrDefault(d => d.Id == a.DoctorId) ?? new MockClinicData.Doctor("?", "Unknown", "");
        return ViewerRole switch
        {
            "patient" => doctor.Name,
            "doctor"  => patient.Name,
            "staff"   => $"{patient.Name} · {doctor.Name}",
            _         => ""
        };
    }

    private static string ApptCss(string type) => type switch
    {
        "medical" => "appt-medical",
        "lab"     => "appt-lab",
        "intake"  => "appt-intake",
        "admin"   => "appt-admin",
        _         => "appt-default"
    };

    private static string FormatHour(int h) => DateTime.Today.AddHours(h).ToString("h:mm tt");
    private static string FormatRange(MockClinicData.Appointment a) => $"{a.Start:h:mm tt} – {a.End:h:mm tt}";

    private string ApptStyle(DateTime day, MockClinicData.Appointment a)
    {
        var startMin = (a.Start - day.Date).TotalMinutes;
        var endMin   = (a.End   - day.Date).TotalMinutes;
        var visStart = Math.Max(startMin, StartHour * 60);
        var visEnd   = Math.Min(endMin,   EndHour   * 60);
        var top    = (visStart - StartHour * 60) / 60d * HourHeightPx;
        var height = Math.Max((visEnd - visStart) / 60d * HourHeightPx, 18);
        return $"top:{top:0}px; height:{height:0}px;";
    }
}
