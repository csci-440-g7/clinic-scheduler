@page "/account/change-password"
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Change Password</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-6">
    <MudItem xs="12" sm="8" md="5" lg="4">
        <MudPaper Elevation="2" Class="pa-6">
            <div class="d-flex align-center mb-5 gap-2">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => Nav.NavigateTo("/"))" />
                <MudText Typo="Typo.h6">Change Password</MudText>
            </div>

            @if (_errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true"
                          CloseIconClicked="@(() => _errorMessage = null)">
                    @_errorMessage
                </MudAlert>
            }

            <MudTextField @bind-Value="_currentPassword" Label="Current Password"
                          InputType="InputType.Password" Variant="Variant.Outlined"
                          Class="mb-4" />

            <MudTextField @bind-Value="_newPassword" Label="New Password"
                          InputType="InputType.Password" Variant="Variant.Outlined"
                          Class="mb-4" />

            <MudTextField @bind-Value="_confirmPassword" Label="Confirm New Password"
                          InputType="InputType.Password" Variant="Variant.Outlined"
                          Class="mb-5" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="SubmitAsync" Disabled="_saving">
                @(_saving ? "Saving…" : "Update Password")
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private string? _errorMessage;
    private bool _saving;

    private async Task SubmitAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_currentPassword) ||
            string.IsNullOrWhiteSpace(_newPassword) ||
            string.IsNullOrWhiteSpace(_confirmPassword))
        {
            _errorMessage = "All fields are required.";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "New passwords do not match.";
            return;
        }

        _saving = true;
        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User)
                ?? throw new InvalidOperationException("Authenticated user not found.");

            var result = await UserManager.ChangePasswordAsync(user, _currentPassword, _newPassword);
            if (result.Succeeded)
            {
                Snackbar.Add("Password updated successfully.", Severity.Success);
                Nav.NavigateTo("/");
            }
            else
            {
                _errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
