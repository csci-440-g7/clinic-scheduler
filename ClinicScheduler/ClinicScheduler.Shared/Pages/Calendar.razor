@page "/calendar"
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IDbContextFactory<ClinicDbContext> DbFactory

@attribute [Authorize]

<h1>Appointments</h1>

@{
    var role = _userRole ?? "patient";
}

@if (role == "Patient")
{
    <CalendarView ViewerRole="patient" PatientId="@_patientId" />
}
else if (role == "Therapist")
{
    <CalendarView ViewerRole="doctor" TherapistId="@_therapistId" />
}
else
{
    <CalendarView ViewerRole="staff" />
}

@code {
    private string? _userRole;
    private int? _patientId;
    private int? _therapistId;

    protected override async Task OnInitializedAsync()
    {
        var authStateResult = await AuthState.GetAuthenticationStateAsync();
        var user = authStateResult.User;

        if (user.Identity is null || !user.Identity.IsAuthenticated)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var email = user.Identity.Name;

        if (user.IsInRole("Patient"))
        {
            _userRole = "Patient";
            var patient = await db.Patients.FirstOrDefaultAsync(p => p.Email == email);
            _patientId = patient?.Id;
        }
        else if (user.IsInRole("Therapist"))
        {
            _userRole = "Therapist";
            var therapist = await db.Therapists.FirstOrDefaultAsync(t => t.Email == email);
            _therapistId = therapist?.Id;
        }
        else
        {
            _userRole = "Staff";
        }
    }
}
