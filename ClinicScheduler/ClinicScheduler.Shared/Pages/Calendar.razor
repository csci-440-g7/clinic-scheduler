@page "/calendar"
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

@attribute [Authorize]

<h1>Appointments</h1>

@{
    var role = _userRole ?? "patient";
}

@if (role == "Patient")
{
    <CalendarView ViewerRole="patient" />
}
else if (role == "Therapist")
{
    <CalendarView ViewerRole="doctor" />
}
else
{
    <CalendarView ViewerRole="staff" />
}

@code {
    private string? _userRole;

    protected override async Task OnInitializedAsync()
    {
        var authStateResult = await AuthState.GetAuthenticationStateAsync();
        var user = authStateResult.User;

        if (user.Identity is null || !user.Identity.IsAuthenticated)
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        if (user.IsInRole("Patient"))
            _userRole = "Patient";
        else if (user.IsInRole("Therapist"))
            _userRole = "Therapist";
        else
            _userRole = "Staff";
    }
}
