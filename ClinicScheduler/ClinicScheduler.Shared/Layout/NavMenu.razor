                </div>
                <div class="nav-item px-3">
                    <form method="post" action="/account/logout" style="margin:0;">
                        <button type="submit" class="nav-link btn btn-link w-100 text-start p-0">
                            <RadzenIcon Icon="logout" aria-hidden="true" /> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
