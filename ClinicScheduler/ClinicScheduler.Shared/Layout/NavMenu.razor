        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="schedule">
                <RadzenIcon Icon="calendar_month" aria-hidden="true" /> Schedule
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="patients">
                <RadzenIcon Icon="people" aria-hidden="true" /> Patients
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="therapists">
                <RadzenIcon Icon="badge" aria-hidden="true" /> Therapists
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="treatment-plans">
                <RadzenIcon Icon="assignment" aria-hidden="true" /> Treatment Plans
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="rooms">
                <RadzenIcon Icon="meeting_room" aria-hidden="true" /> Rooms
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="therapy-types">
