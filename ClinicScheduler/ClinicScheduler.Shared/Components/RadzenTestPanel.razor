<RadzenCard Style="max-width: 520px; margin-top: 1rem;">
    <div class="rz-p-4">
        <h3>Radzen Test Component</h3>
        <p>Count: @_count</p>

        <RadzenButton Text="Increment" Icon="add_circle" Click="@Increment" Style="margin-right: .5rem;" />
        <RadzenButton Text="Reset" ButtonStyle="ButtonStyle.Secondary" Icon="refresh" Click="@Reset" />

        <RadzenAlert Style="margin-top: 1rem;" AlertStyle="AlertStyle.Info" ShowIcon="true">
            If you can see this card, buttons, and alert, Radzen is loaded correctly.
        </RadzenAlert>
    </div>
</RadzenCard>

@code {
    private int _count;

    private void Increment()
    {
        _count++;
    }

    private void Reset()
    {
        _count = 0;
    }
}