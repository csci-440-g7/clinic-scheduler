# Copy this file to .env and fill in real values before running docker-compose on EC2.
# Never commit .env to source control — it contains secrets.

# PostgreSQL password — used by both the db container and the app connection string.
# Any strong value is fine; no complexity requirements from the app.
POSTGRES_PASSWORD=changeme

# Admin account password seeded on first run.
# PRODUCTION REQUIREMENTS: min 10 characters, at least one uppercase letter,
# one digit, and one special character (e.g. MyAdmin@2026!)
SEED_ADMIN_PASSWORD=changeme

# Set to Production on EC2; leave as Development for local dev.
# WARNING: Production enforces the password policy above. Using Development
# on EC2 relaxes password rules but also enables Swagger UI — not recommended.
ASPNETCORE_ENVIRONMENT=Production
